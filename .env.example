# ===========================================================================
# OUT-01 Cold Email Automation
# Copy to .env and fill in. Never commit .env.
# ===========================================================================

# --- Database (Supabase REST API) ------------------------------------------
# Supabase > Project Settings > API Keys (and Data API for the URL).
# The service uses the SECRET key; keep it out of anything you share or commit.
# Also required once: Project Settings > Data API > Exposed schemas > add
# `cold_email` (only the secret key can use anything in it).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Not used by the service (it has no rights in cold_email); optional.
SUPABASE_PUBLISHABLE_KEY=

# --- LLM -------------------------------------------------------------------
# Which driver drafts the emails: gemini | omniroute
LLM_PROVIDER=gemini
# Optional cross-provider fallback if the primary is down: gemini | omniroute | none
LLM_FALLBACK_PROVIDER=omniroute

# Google AI Studio key (free tier, no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OmniRoute, addressed as an OpenAI-compatible gateway.
OMNIROUTE_API_KEY=
# OmniRoute runs on your machine, not inside the container. Inside Docker,
# "localhost" is the container itself, so use host.docker.internal (mapped to
# your machine in docker-compose.yml). Running without Docker? Use
# http://localhost:20128/ instead.
OMNIROUTE_BASE_URL=http://host.docker.internal:20128/
OMNIROUTE_MODEL=landing page
OMNIROUTE_FALLBACK_MODEL=gemini-2.5-flash

LLM_TEMPERATURE=0.7

# --- Mail transport --------------------------------------------------------
# Sender and reader are chosen independently.
#   MAIL_SENDER: smtp | graph
#   MAIL_READER: imap | graph
MAIL_SENDER=smtp
MAIL_READER=imap

# SMTP defaults. Override per inbox via inboxes.config if they differ.
#   Outlook/M365 : smtp.office365.com : 587 : STARTTLS
#   Zoho         : smtp.zoho.com      : 465 : SSL
#   Local relay  : localhost          : 25  : neither
SMTP_HOST=smtp.gmail.com   # smtp.office365.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false

# IMAP defaults.
#   Outlook/M365 : outlook.office365.com : 993 : SSL
#   Zoho         : imap.zoho.com         : 993 : SSL
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SSL=true
IMAP_FOLDER=INBOX

# Microsoft Graph — only needed if MAIL_SENDER or MAIL_READER is "graph".
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Per-inbox secrets -----------------------------------------------------
# Each inboxes row stores a credential_ref (e.g. INBOX_A); the secret is read
# from <REF>_SMTP_PASSWORD here. Secrets never go in the database.
INBOX_A_SMTP_PASSWORD=


# Optional, only if IMAP uses a different credential than SMTP:
# INBOX_A_IMAP_PASSWORD=
# INBOX_B_SMTP_PASSWORD=
# INBOX_C_SMTP_PASSWORD=



# --- Sending identity ------------------------------------------------------
# Address for the List-Unsubscribe header. Defaults to the sending inbox.
UNSUBSCRIBE_MAILTO=
# Optional Reply-To if replies should land somewhere other than the sender.
REPLY_TO=

# --- Workers ---------------------------------------------------------------
RUN_WORKERS=true
INTAKE_INTERVAL_SECONDS=300
SEND_INTERVAL_SECONDS=180
POLL_INTERVAL_SECONDS=600
# Reply triage (OUT-05): classify replies, act on them, send due drafts.
TRIAGE_INTERVAL_SECONDS=60

# --- Calendar (meeting booking for reply triage) ---------------------------
# calcom | fake | none   (google / microsoft are reserved for later)
#   calcom: real bookings through Cal.com
#   fake:   an in-memory test calendar; nothing is booked anywhere
#   none:   no slots offered; interested leads are asked which times suit them
CALENDAR_PROVIDER=calcom
# Cal.com > Settings > Developer > API keys (starts with cal_live_)
CALCOM_API_KEY=
# The event type to book: its number (Cal.com > Event Types > open it; the
# number in the address bar) or its slug, e.g. 30min. With a slug, Cal.com
# also needs your username, taken from CALCOM_BOOKING_URL or CALCOM_USERNAME.
CALCOM_EVENT_TYPE_ID=
# Public booking page put in emails, e.g. https://cal.com/yourname/30min
CALCOM_BOOKING_URL=
# Only needed for a slug when CALCOM_BOOKING_URL is not set.
CALCOM_USERNAME=
# How often to read Cal.com's bookings, so meetings a lead books through the
# link show up on the Meetings page and stop their sequence.
CALENDAR_SYNC_INTERVAL_SECONDS=300

# --- Email Nurture -----------------------------------------------------------
# Nurture sends from its OWN account, never from a cold inbox, so complaints
# about cold outbound cannot hurt nurture deliverability. For now a separate
# free Gmail with an app password; later a provider on a subdomain.
NURTURE_FROM_EMAIL=
NURTURE_FROM_NAME=
NURTURE_SMTP_PASSWORD=
# Only when they differ from SMTP_HOST / SMTP_PORT / IMAP_HOST above:
NURTURE_SMTP_HOST=
NURTURE_SMTP_PORT=
NURTURE_IMAP_HOST=
# NURTURE_IMAP_PASSWORD=   (defaults to NURTURE_SMTP_PASSWORD)
# Replies go to an inbox Reply Triage already reads. Empty: the first active
# cold inbox.
NURTURE_REPLY_TO=
# Public base for tracked links and the unsubscribe page (no login). Empty:
# APP_PUBLIC_URL + /api, fine for test mode. Before going live, point an
# HTTPS subdomain at the console and set e.g. https://go.yourdomain.com/api
NURTURE_PUBLIC_URL=
# false = run no nurture jobs at all (the tab still works).
NURTURE_WORKERS=true
NURTURE_ENROLL_INTERVAL_SECONDS=300
NURTURE_GENERATE_INTERVAL_SECONDS=60
NURTURE_SEND_INTERVAL_SECONDS=60
NURTURE_POLL_INTERVAL_SECONDS=600
NURTURE_RECONCILE_INTERVAL_SECONDS=3600

# --- Safety ----------------------------------------------------------------
# true = everything runs but no mail actually leaves. Keep this on until the
# end-to-end test has passed.
DRY_RUN=true

LOG_LEVEL=INFO
# Optional bearer token for scripts/cron calling the API directly
# (Authorization: Bearer <API_KEY>). Empty = only signed-in console users.
API_KEY=

# --- Login (CMS-linked, required) -------------------------------------------
# The console signs in through CMS; the service will not start without these.
# APP_PUBLIC_URL: the console's origin (Vite dev server). CMS_PUBLIC_URL: CMS.
# SSO_CLIENT_SECRET: random URL-safe 32+ chars, identical to CMS's
# COLD_EMAIL_SECRET (and different from the landing page's secret).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_PUBLIC_URL=http://localhost:5173
CMS_PUBLIC_URL=http://localhost:8102
SSO_CLIENT_SECRET=

# Host ports: HOST_PORT = backend API (loopback only), FRONTEND_PORT = console.
# FRONTEND_PORT must match the port in APP_PUBLIC_URL.
HOST_PORT=8080
FRONTEND_PORT=5173
